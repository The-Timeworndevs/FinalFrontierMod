{
	"schemaVersion": 1,
	"id": "final_frontier",
	"version": "${version}",
	"name": "Final Frontier",
	"description": "An expansive, modern space mod for Fabric",
	"authors": [
		"VoxelDragon6 (Lead)",
		"ADInfinity59 (Rendering)"
	],
	"contact": {
		"homepage": "",
		"sources": "https://github.com/The-Timeworndevs/FinalFrontierMod/tree/main"
	},
	"license": "MIT",
	"icon": "assets/final_frontier/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.tws.final_frontier.Main"
		],
		"client": [
			"net.tws.final_frontier.client.Client"
		],
		"fabric-datagen": [
			"net.tws.final_frontier.client.data.DataGenerator"
		]
