		"fabric-api": "*",
		"lithostitched": ">=1.8.0+beta6-fabric-26.2",
		"datapatched": ">=2.2.1-fabric-26.2",
		"rrv": ">=8.10.9",
		"trinkets": ">=4.1.1+26.2"
